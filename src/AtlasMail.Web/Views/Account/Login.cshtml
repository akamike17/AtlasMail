@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h4 class="card-title mb-3 text-center">AtlasMail</h4>
                <div id="errorBox" class="alert alert-danger d-none" role="alert"></div>
                <form id="loginForm">
                    <div class="mb-3">
                        <label class="form-label">Usuario</label>
                        <input type="text" id="username" name="username" class="form-control" autocomplete="username" required autofocus />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Contraseña</label>
                        <input type="password" id="password" name="password" class="form-control" autocomplete="current-password" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100" id="loginBtn">Entrar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
$(function () {
    $('#loginForm').on('submit', async function (e) {
        e.preventDefault();
        $('#errorBox').addClass('d-none');
        const username = $('#username').val().trim();
        const password = $('#password').val();
        try {
            const res = await fetch('/api/auth/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username, password })
            });
            const data = await res.json();
            if (!res.ok) {
                $('#errorBox').text(data.error || 'Credenciales inválidas').removeClass('d-none');
                return;
            }
            window.location.href = '/';
        } catch (err) {
            $('#errorBox').text('Error de conexión. Intenta de nuevo.').removeClass('d-none');
        }
    });
});
</script>
}